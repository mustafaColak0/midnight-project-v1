pragma language_version 0.23;

import CompactStandardLibrary;

export ledger proposalActive: Boolean;
export ledger yesVotes: Counter;
export ledger noVotes: Counter;
export ledger totalVotes: Counter;

constructor() {
    proposalActive = true;
}

export circuit voteYes(secretValue: Uint<16>): [] {
    assert(
        proposalActive,
        "The governance proposal is not active"
    );

    assert(
        secretValue >= 18,
        "The private eligibility requirement was not satisfied"
    );

    yesVotes.increment(1);
    totalVotes.increment(1);
}

export circuit voteNo(secretValue: Uint<16>): [] {
    assert(
        proposalActive,
        "The governance proposal is not active"
    );

    assert(
        secretValue >= 18,
        "The private eligibility requirement was not satisfied"
    );

    noVotes.increment(1);
    totalVotes.increment(1);
}